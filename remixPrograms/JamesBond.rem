#given_name and #family_name from 'name' :
	#given_name : ""
	#family_name : ""
	'first' : true
	for each 'character' in 'name'
		when
			[ 'character' = SPACE ] do [ 'first' : false ]
			[ 'first' ] do [ #given_name : #given_name ⊕ 'character' ]
			#family_name : #family_name ⊕ 'character'

'forename' and 'surname' from "James Bond"
"My name is ", 'surname', ". ", 'forename', " ", 'surname', "." ↲
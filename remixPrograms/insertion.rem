================
 Insertion Sort
================

insertion sort 'the list' :
	for each 'position' from 2 to (end of 'the list')
		for each 'this' from 'position' to 2
			swap position if element to the left is greater than 'this' in 'the list'

swap position if element to the left is greater than 'this' in 'the list' ::
- N.B. transparent short circuit
	'left' : 'this' - 1
	if ('the list'{'left'} > 'the list'{'this'})
		swap ('the list'{'left'}) with ('the list'{'this'})
	… otherwise
		return

-< Example using this along with a function to check for missing values. >-

'the list' : apply [random 100] 400 times ; a list of 400 random values from 1 to 100

"unsorted: ", 'the list' ↲ ; print the unsorted list

print missing values in 'the list'

insertion sort 'the list'

"sorted: ", 'the list' ↲ ; print the sorted list

----------

print missing values in 'the list' :
	'count of values' : apply [0] 100 times
	count each item in 'the list' into 'count of values'
	for each 'item' in 'count of values' keeping 'count'
		if ('item' = 0)
			'count', " is missing" ↲

count each item in 'the list' into 'tally' :
	for each 'item' in 'the list'
		increment ('tally'{'item'})



prepend 'item' to 'list' :
	'item list' : {'item'}
	join 'item list' and 'list'

'list' : {2, 4, 8, 16, 32}
'result1' : prepend 1 to 'list'

'prepend' : function
	'item list' : {'item'}
	join 'item list' and 'list'

'result2' : 'prepend' {"item" : 1, "list" : 'list'}

'prepend2' : function
	'item list' : { '1' }
	join 'item list' and '2'

'result3' : 'prepend2' {1, 'list'}

'square plus 1' : function 
	'1'² + 1

'square plus 1' 50 ↲

'result1' ↲
'result2' ↲
'result3' ↲
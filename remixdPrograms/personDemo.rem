- A simple demo

a person called 'name' :
	create 'name'
		'type' : "person"
		
		introduce ME to 'other' :
			"Dear ", 'other' ~
			", I am pleased to present ", 'name', "." ↲
		
		ME to string :
			'name'

'r' : a person called "Robert"
'j' : a person called "James"

introduce 'r' to 'j'
'r', " is a ", type of 'r' ↲

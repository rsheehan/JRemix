library
		- Constants for directions.
	NORTH : 1
	SOUTH : 2
	WEST : 3
	EAST : 4
	
	=-
	Create a grid object with 'rows' of 'columns' each.
	=-
	a grid of 'rows' by 'columns' :
		create 'rows', 'columns'
			'type' : "Maze Grid"
			'cells' : do 
				for each 'row' from 1 to 'rows' 
					for each 'column' from 1 to 'columns'
						'cells'{'row'}{'column'} : a cell at 'row' 'column'
				'cells'
			
			=-
			Return the cell at position {'row', 'column'} of grid 'OBJECT'.
			=-
			MY cell at 'row' by 'column' :
				if (all of {
					['row' is in (1 to 'rows')]
					['column' is in (1 to 'columns')]
				})
					return 'cells'{'row'}{'column'}
				null
			
			=-
			Return a random cell from the grid 'OBJECT'.
			=-
			MY random cell :
				'cells'{random 'rows'}{random 'columns'}
				
			=-
			Return the number of cells in the grid 'OBJECT'.
			=-
			MY size :
				'rows' × 'columns'
			
			=-
			Creates the iterator for the grid 'OBJECT'.
			Produces each row.
			=-
			iterator from ME :
				create 'cells', 'rows'
					'row' : 0
							
					end ME :
						'row' = 'rows'
						
					next ME :
						increment 'row'
						'cells'{'row'}
	
	=-
	Create a single cell with connections to 
	surrounding ones.
	=-
	a cell at 'row' 'column':
		create
			'type' : "Maze Cell"
			'row' : 'row'
			'column' : 'column'
			'links' : { }
			'directions' : {
				{'row' - 1, 'column'}
				{'row' + 1, 'column'}
				{'row', 'column' - 1}
				{'row', 'column' + 1}
			}
			
			getters
				'row', 'column', 'links', 'directions'
			
			=-
			Return a string represenation of the cell 'OBJECT'.
			=-
			ME to string :
				"<" ⊕ 'row' ⊕ ", " ⊕ 'column' ⊕ ">"
			
			=-
			Connect this cell 'OBJECT' to 'other cell'.
			=-
			link ME to 'other cell' :
				'links'{'other cell'} : true ; this means connected

			=-
			Disconnect this cell 'OBJECT' from 'other cell'.
			=-
			unlink ME from 'other cell' : ; should really have a map delete
				'links'{'other cell'} : false

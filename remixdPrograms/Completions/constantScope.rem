ABC : 4

inside func :
	"inside ", ABC ↲
-	"inside ", DEF ↲ ; not found the first time
-	"inside ", GHI ↲ ; not found the first time
-	"inside ", JKL ↲ ; not found, then 8 from program lib
	
inside func
↲
"outside ", ABC ↲
-"outside ", DEF ↲ ; not found because doesn't exist yet
-"outside ", GHI ↲ ; not found because doesn't exist yet
-"outside ", JKL ↲ ; ditto
↲
using graphics
	DEF : 5
	GHI : 6
	"using ", ABC ↲
	"using ", DEF ↲
	"using ", GHI ↲
	"using ", STD-WIDTH ↲
-	"using ", JKL ↲ ; not found
↲
THE-LIB : library
	JKL : 7
	"library ", ABC ↲
	"library ", DEF ↲
	"library ", GHI ↲
	"library ", JKL ↲
↲
JKL : 8 ; this is in the program, different from the one in THE-LIB
inside func
↲
using THE-LIB
	"inside using ", JKL ↲
	inside func
↲
-"outside ", STD-WIDTH ↲ ; not found
STD-WIDTH : 999
"outside ", STD-WIDTH ↲
↲
using graphics, THE-LIB
	"using ", ABC ↲
	"using ", DEF ↲
	"using ", GHI ↲
	"using ", STD-WIDTH ↲ ; gets 1000 from graphics
	"using ", JKL ↲ ; 7 from THE-LIB

=
inside 4

outside 4

using 4
using 5
using 6
using 1000

library 4
library 5
library 6
library 7

inside 4

inside using Warning: Constant "JKL" has multiple values.
7
inside 4

outside 999

using 4
using 5
using 6
using Warning: Constant "STD-WIDTH" has multiple values.
1000
using Warning: Constant "JKL" has multiple values.
7
=

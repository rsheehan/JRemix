===============================
Graphics Operations and Objects
===============================
library "edu.fizz.remixd.libraries.Graphics"

	=====================
	Dimensions and points
	=====================
	STD-WIDTH  : 1000
	STD-HEIGHT : 800
	CENTRE-X   : STD-WIDTH ÷ 2
	CENTRE-Y   : STD-HEIGHT ÷ 2
	THE-CENTRE-POINT : { CENTRE-X, CENTRE-Y }

	=-
	A random point in the standard graphics window.
	=-
	random point :
		{ random STD-WIDTH, random STD-HEIGHT }

	=======
	Colours
	=======
	WHITE     : { 255, 255, 255 }
	BLACK     : { 0, 0, 0 }
	RED       : { 255, 0, 0 }
	GREEN     : { 0, 255, 0 }
	BLUE      : { 0, 0, 255 }
	DARK-BLUE : { 0, 0, 50 }
	SKY-BLUE  : { 180, 230, 255 }
	YELLOW    : { 255, 255, 0 }
	ORANGE    : { 255, 165, 0 }
	GREY      : { 128, 128, 128 }
	DARK-GREY : { 64, 64, 64 }

	=-
	A random colour.
	=-
	random colour :
		{ random 255, random 255, random 255 }

-==================================================================================================-

	================
	Graphics objects
	================

	======
	Shapes
	======

	=-
	Create a triangle.
	=-
	a triangle :
		a 3 sided polygon

	=-
	Create a square.
	=-
	a square :
		a 4 sided polygon

	=-
	Create an 'n' sided polygon.
	=-
	a/an 'n' sided polygon :
		'points' : {}
		for each 'side' from 0 to ('n' - 1)
			append {
				cosine (2π × 'side' ÷ 'n')
				sine (2π × 'side' ÷ 'n')
			} to 'points'
		a shape from 'points' scaled by 20

	=-
	Create a box centred at 'position'
	with 'colour' and 'width' x 'height'.
	=-
	a/an 'colour' box of 'width' x/by 'height' at 'position' :
		'left'   : -'width' ÷ 2
		'right'  : 'width' ÷ 2
		'top'    : -'height' ÷ 2
		'bottom' : 'height' ÷ 2
		a 'colour' shape from {
			{ 'left', 'top' }
			{ 'right', 'top' }
			{ 'right', 'bottom' }
			{ 'left', 'bottom' }
		} scaled by 1 at 'position'

	=-
	Create a red shape from the list of 'points'.
	The shape is scaled by 5.
	=-
	a shape from 'points' :
		a shape from 'points' scaled by 5

	=-
	Create a red shape from the list of 'points' scaled by 'size'.
	=-
	a shape from 'points' scaled by 'size' :
		a RED shape from 'points' scaled by 'size' at THE-CENTRE-POINT

	=-
	Create a shape of 'colour' from the list of 'points' scaled by 'size'
	at 'position'.
	'shapes' can be filled or just outlines.
	=-
	a/an 'colour' shape from 'points' scaled by 'size' at 'position':

		extend a shape at 'position', 'colour', 'size'
			'outline colour' : null ; no outline
			'polygon'        : 'points'
			'heading'        : 0.0 ; radians

			getters/setters
				'colour', 'outline colour',
				'size', 'heading'

			getter
				'type'

			=-
			Change shape 'OBJECT' heading by 'δd' degrees.
			=-
			change MY heading by 'δd' degrees/degree :
				add ('δd' degrees as radians) to 'heading'

	=-
	Create a graphic object with a 'position'.
	=-
	a shape at 'position' :
		create 'position'
			'type' : "Shape"

			getter/setter
				'position'

			=-
			The x-position of the shape 'OBJECT'.
			=-
			MY x-pos : ; a fake getter
				'position'{1}

			=-
			The y-position of the shape 'OBJECT'.
			=-
			MY y-pos : ; a fake getter
				'position'{2}

			=-
			Change shape 'OBJECT' x-position by 'δx'.
			=-
			change MY x-pos by 'δx' :
				add 'δx' to ('position'{1})

			=-
			Change shape 'OBJECT' y-position by 'δy'.
			=-
			change MY y-pos by 'δy' :
				add 'δy' to ('position'{2})

	=====
	Lines
	=====

	=-
	Create a 'colour' line from 'start' to 'finish'.
	The width is 3 pixels by default.
	=-
	a/an 'colour' line from 'start' to 'finish' :
		create 'start', 'finish', 'colour'
			'type'   : "Line"
			'width'  : 3

			getters/setters
				'start', 'finish', 'width', 'colour'

			=-
			Change line 'OBJECT' x-position by 'δx'.
			=-
			change MY x-pos by 'δx' :
				add 'δx' to ('start'{1})
				add 'δx' to ('finish'{1})

			=-
			Change line 'OBJECT' y-position by 'δy'.
			=-
			change MY y-pos by 'δy' :
				add 'δy' to ('start'{2})
				add 'δy' to ('finish'{2})

	=-
	Create a green line from 'start' to 'finish'.
	=-
	a line from 'start' to 'finish' :
		a GREEN line from 'start' to 'finish'

	=-
	Create a random line.
	=-
	a random line :
		a (random colour) line from (random point) to (random point)

	=======
	Circles
	=======

	=-
	Create a 'colour' circle of radius 'radius' at 'position'.
	=-
	a/an 'colour' circle of radius 'radius' at 'position' :
		extend a shape at 'position', 'colour', 'radius'
			'type'     : "Circle"
			'outline colour' : null ; no outline

			getters/setters
				'colour', 'outline colour',
				'radius'

	=-
	Create a random circle.
	=-
	a random circle :
		'size' : random (STD-HEIGHT ÷ 8) + 10
		a (random colour) circle of radius 'size' at (random point)

-==================================================================================================-

	===========================================================
	The Remix 'panel' for drawing.
	It has a base layer which is an image for permanent shapes,
	and multiple layers for animation on top of that.

	It is a panel in a graphics window.
	Action events are associated with the panel.
	===========================================================
	=-
	Return a panel with multiple layers based on 'JGraphics panel'.
	=-
	a 'JGraphics panel' with layers :
		'panel' : create 'JGraphics panel'
			'type' : "Graphics Panel"
			'layers' : { a base layer for 'JGraphics panel' }
			'colour' : DARK-BLUE ; set by "MY colour 'the colour'"

			getters
				'JGraphics panel', 'layers', 'colour'

			=-
			Set 'the colour' of the 'OBJECT'.
			=-
			MY colour 'the colour' : ; this is a setter
				'colour' : 'the colour'
				make the 'JGraphics panel' background 'colour' ; Java

			=-
			Add and return a new shape layer for the panel 'OBJECT'.
			=-
			MY next layer :
				'new layer' : a shape layer
				append 'new layer' to 'layers'
				'new layer'

			=-
			Get the permanent base layer for the panel 'OBJECT'.
			=-
			MY base layer : ; a fake getter
				'layers'{1}

			=-
			Place the 'shape' in the base layer of the panel 'OBJECT'.
			=-
			place 'shape' in ME :
				place 'shape' in ('layers'{1})

			=-
			Update the panel 'OBJECT'.
			This redraws all layers.
			=-
			update ME :
				clear transient 'JGraphics panel' layers ; Java
				for each 'layer' in 'layers'
					prepare 'layer' shapes for drawing on 'JGraphics panel'
				refresh 'JGraphics panel' ; Java
			
			=-
			Hide the mouse cursor when over the panel 'OBJECT'.
			=-
			hide MY mouse cursor :
				hide cursor over 'JGraphics panel' ; Java

			=-
			Show the mouse cursor when over the panel 'OBJECT'.
			=-
			show MY mouse cursor :
				show cursor over 'JGraphics panel' ; Java
				
			==================
			Clears all layers.
			==================
			=-
			Clear all layers of the panel 'OBJECT' including the base layer.
			=-
			clear ME :
				clear 'JGraphics panel' base layer
				clear ME leaving the base layer

			=-
			Clear all layers of the panel 'OBJECT' keeping the base layer.
			=-
			clear ME leaving the base layer :
				make the 'JGraphics panel' background 'colour'
				'layers' : { 'layers'{1} }
				update ME

			======
			Events
			======
			
			=-
			Set up a key action.
			When the 'key' is pressed in the panel 'OBJECT' the [block] executes.
			Keys are "A" "B" … "Z" but also "UP", "DOWN" etc.
			=-
			when 'key' pressed in ME ['block'] :
				when 'key' pressed in the 'JGraphics panel' do 'block' ; Java
			
			=-
			Set up a mouse move action.
			When the mouse moves in the panel 'OBJECT' the 'position' gets filled in
			with the current mouse position and the 'block' is executed.
			Normally the 'block' will use the 'position' variable.
			=-
			when mouse moves in ME use #position ['block'] :
				#position : {}
				when mouse moves in the 'JGraphics panel' get #position do 'block' ; Java
			
			=-
			Set up a mouse button pressed action.
			When the mouse button is pressed in the panel 'OBJECT' the 'position' gets
			filled in with the current mouse position and the 'block' is executed.
			Normally the 'block' will use the 'position' variable.
			=-
			when mouse pressed in ME use #position ['block'] :
				#position : {}
				when mouse button is pressed in the 'JGraphics panel' get #position
					… do 'block' ; Java

		clear 'panel'
		'panel'

	================
	Graphics Windows
	================
	=-
	Open a graphics window with multiple layers.
	Return the graphics panel.
	=-
	a graphics window :
		'JWindow' : a "Drawing" window of STD-WIDTH by STD-HEIGHT ; Java
		show 'JWindow' ; Java
		'JGraphics panel' : the 'JWindow' graphics panel ; Java
		a 'JGraphics panel' with layers

	=-
	Create a shape layer.
	'shapes' get added to layers.
	This does not include the base layer which is special.
	Animations should be placed in ordinary shape layers.
	=-
	a shape layer :
		create
			'type' : "Shape Layer"
			'shapes' : {}

			getter
				'shapes'

			=-
			Place the 'shape' in the shape layer 'OBJECT'.
			=-
			place 'shape' in ME :
				if ('shape' is a "list")
					for each 'part' in 'shape'
						append 'part' to 'shapes'
				… otherwise
					append 'shape' to 'shapes'

			=-
			Clear all shapes from the shape layer 'OBJECT'.
			=-
			clear MY shapes :
				'shapes' : {}

			=-
			Prepare and show the shapes of the shape layer 'OBJECT' on the
			'JGraphics' panel.
			Does nothing to a base layer.
			=-
			prepare MY shapes for drawing on 'JGraphics' :
				for each 'shape' in 'shapes'
					add 'shape' to the 'JGraphics' ; Java

	=-
	Create a base layer for the 'JGraphics panel'.
	'shapes' which get added to a base layer are "permanent"
	until the layer gets cleared.
	Animations should not be placed in the base layer.
	=-
	a base layer for 'JGraphics panel' :
		create 'JGraphics panel'
			'type' : "Base Layer"

			=-
			There are no shapes in the base layer OBJECT.
			Returns an empty list.
			=-
			MY shapes : ; a getter for shapes which are not stored
				{}

			=-
			Place a 'shape' in the base layer 'OBJECT'.
			The 'shape' can have multiple parts.
			=-
			place 'shape' in ME :
				if ('shape' is a "list")
					for each 'part' in 'shape'
						add 'part' to the ('JGraphics panel' base layer) image ; Java
				… otherwise
					add 'shape' to the ('JGraphics panel' base layer) image ; Java

			=-
			Nothing happens in the base layer.
			=-
			clear MY shapes :
				"Clearing shapes from the base layer - does nothing."

			=-
			Nothing happens in the base layer.
			=-
			prepare MY shapes for drawing on 'JGraphics' :
				"Preparing shapes in the base layer - does nothing."

-==================================================================================================-

	=========
	Animation
	=========

	=-
	Create an animation object which executes 'changes' every 'n' ticks.
	=-
	every 'n' tick/ticks ['changes'] :
		create 'changes'
			'ticks' : 'n'
			'counter' : 'n'

			=-
			Animate the animation 'OBJECT'.
			Called after a set number of ticks.
			=-
			animate ME :
				decrement 'counter'
				if ('counter' = 0)
					'counter' : 'ticks'
					do 'changes'

	=======================================================================
	The Java animation function is
	animate at 'n' ticks per second [Animation-block] until [Condition-block]
	=======================================================================

	=-
	Animate 'block' in 'the window' at 'n' ticks per second.
	=-
	animate 'the window' 'number' times at 'n' ticks per second ['block'] :
		animate at 'n' ticks per second
			do 'block'
			update 'the window'
			decrement 'number'
		… until ['number' < 1]

	=-
	Tries to animate the 'action' at 'n' ticks per second, stopping when 'completed'.
	Only allows one such animation at a time based on the 'busy' variable.
	'busy' must be initialised to false before this is first called.
	=-
	exclusive #busy at 'n' ticks per second ['action'] until ['completed'] :
		if #busy
			return
		#busy : true
		animate at 'n' ticks per second …
			do 'action'
		… until
			if 'completed'
				#busy : false
			not #busy

-==================================================================================================-

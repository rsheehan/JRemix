- Example of sequence object.

make 'count' stars :
	- the sequence object
	- must include "start ME" method
	create 'count'

		start ME :
			- the iterator object
			- must include an "end ME" and a "next ME" method
			- can refer to sequence instance variables e.g. 'count'
			- but only in the instance variable assignment section
			- or passed as a create parameter
			create 'count'
				'index' : 0
				'stars' : EMPTY

				end ME :
					'index' = 'count'

				next ME :
					'index' : 'index' + 1
					'stars' : 'stars' ⊕ "*"

STARS : make 8 stars

for each 'line' in STARS
	'line' ↲
